# Copia este archivo a .env.local y pon los mismos valores en Vercel →
# Project Settings → Environment Variables.

# ——— Formulario de contacto (Resend) ———

# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Remitente en un dominio verificado en Resend. Si queda vacío se usa
# onboarding@resend.dev, que solo entrega al correo dueño de la cuenta de Resend.
LEAD_FROM_EMAIL="Caudal <hola@trycaudal.com>"

# A dónde llega el aviso interno de cada solicitud. Nunca se muestra al cliente.
LEAD_NOTIFY_EMAIL=tu-correo@ejemplo.com

# Opcional: a dónde llegan las respuestas del cliente a su correo de confirmación.
LEAD_REPLY_TO=

# ——— Panel de solicitudes (/admin) ———

# Contraseña para entrar. Que sea larga: la página es pública.
ADMIN_PASSWORD=

# Firma la sesión. Genera una con: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ——— Supabase ———
# Con esta variable, las solicitudes se guardan en la tabla sitio.leads. Sin
# ella se guardan en .data/leads.json en tu equipo; en Vercel solo llegan por
# correo. Es el usuario caudal_sitio por el pooler en modo transacción (puerto
# 6543): solo puede leer, crear y actualizar esa tabla. Nunca NEXT_PUBLIC_.
LEADS_DATABASE_URL=postgresql://caudal_sitio.<project-ref>:<contraseña>@<pooler>:6543/postgres

# ——— SEO ———

# Token de verificación de Google Search Console (método "etiqueta HTML").
GOOGLE_SITE_VERIFICATION=
