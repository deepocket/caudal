# Formulario de contacto (Resend). Copia este archivo a .env.local y pon los
# mismos valores en Vercel → Project Settings → Environment Variables.

# API key de https://resend.com/api-keys
RESEND_API_KEY=

# Remitente en un dominio verificado en Resend. Si queda vacío se usa
# onboarding@resend.dev, que solo entrega al correo dueño de la cuenta de Resend.
LEAD_FROM_EMAIL="Caudal <hola@trycaudal.com>"

# A dónde llega el aviso interno de cada solicitud. Nunca se muestra al cliente.
LEAD_NOTIFY_EMAIL=tu-correo@ejemplo.com

# Opcional: a dónde llegan las respuestas del cliente a su correo de confirmación.
LEAD_REPLY_TO=
